# Boletín PATRIAM en Hostinger
Options -Indexes
# Piezas internas de PHP: no se abren desde fuera
<FilesMatch "^_">
  Require all denied
</FilesMatch>
RewriteEngine On
# Pasa la cabecera Authorization a PHP
RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]
# Comunicaciones personales: en Hostinger (com.php), sin pasar por Netlify
RewriteRule ^api/com-(datos|guardar|claves|enviar)$ com.php?accion=$1 [QSA,L]
RewriteRule ^img-com/([0-9a-f]{32}\.(png|jpg|gif|webp))$ com.php?img=$1 [L]
# Funciones (provisionalmente en Netlify) a través del puente
RewriteCond %{REQUEST_FILENAME} !-f
RewriteRule ^(api/[A-Za-z0-9_-]+|img/[^/]+|a/[^/]+|boletin/[^/]+|boletines\.js)$ proxy.php?__r=$1 [QSA,L]
# Todo lo demás: la página del boletín
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^ index.html [L]
